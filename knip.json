{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}",
    "src/router.tsx",
    "src/server.ts",
    "src/start.ts",
    "api/index.mjs",
    "server/node.mjs",
    "vite.config.ts",
    "scripts-stripe-setup.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "api/**/*.mjs", "server/**/*.mjs"],
  "ignore": ["src/integrations/supabase/types.ts", "src/routeTree.gen.ts"],
  "ignoreDependencies": ["tailwindcss", "@tailwindcss/vite", "tw-animate-css"]
}
