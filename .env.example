# Copie para .env e preencha. O .env de verdade NÃO vai para o git.
#
# As VITE_* são embutidas no bundle do navegador — só coloque nelas o que pode
# ser público. As demais ficam apenas no servidor.

# ---------------------------------------------------------------------------
# Supabase — obrigatório, o app não sobe sem isso
# ---------------------------------------------------------------------------
# Painel do Supabase > Project Settings > Data API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-publishable-key
SUPABASE_PROJECT_ID=seu-project-id

# Mesmos valores acima, expostos ao navegador (é o mesmo par público)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key
VITE_SUPABASE_PROJECT_ID=seu-project-id

# Chave service_role — ignora RLS, uso exclusivo do servidor.
# NUNCA prefixe com VITE_ e nunca comite. Necessária para operações
# administrativas e para o webhook do Stripe.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---------------------------------------------------------------------------
# Domínio público — opcional, mas recomendado em produção
# ---------------------------------------------------------------------------
# Base dos links do questionário (QR code, link copiado) e da imagem de
# compartilhamento. Sem isso o app usa o domínio em que está sendo servido,
# o que funciona na maioria dos casos.
# VITE_PUBLIC_APP_ORIGIN=https://app.seudominio.com.br

# ---------------------------------------------------------------------------
# Stripe — opcional, só se for usar a tela de assinatura
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
